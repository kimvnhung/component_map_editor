@startuml
title PropertyPanel loads tokenRef options through DynamicOptionsRegistry

actor User
participant "PropertyPanel" as PP
participant "DynamicOptionsRegistry" as DOR
participant "GraphModel" as GM
participant "ConnectionModel[*]" as CM
participant "SchemaFormRenderer" as SFR

User -> PP : Select component
PP -> DOR : setTargetComponentId(component.id)
PP -> DOR : setGraph(currentGraph)
PP -> DOR : refresh()

group refresh() orchestration
DOR -> GM : connectionList()
loop incoming connections for target component
DOR -> CM : read id, sourceId, targetId
DOR -> GM : resolve source component
DOR -> DOR : read declared output keys
DOR -> DOR : append tokenRef option\n(text, value, key, tokenId, sourceId)
end
DOR -> DOR : sort options by text
DOR -> DOR : register source "tokenRef"
DOR -> PP : emit targetSourceOptionsChanged
end

PP -> PP : dynamicOptions = registry.targetSourceOptions
PP -> SFR : pass schemaSectionModel + dynamicOptions

alt field.dropdownOptions.sourceKey = tokenRef
SFR -> SFR : ComboBox model = dynamicOptions.tokenRef
note right
Object rows:
text, value, key,
tokenId, sourceId
end note
else field has another sourceKey
SFR -> SFR : Resolve dynamicOptions[sourceKey]
else field has no sourceKey
SFR -> SFR : Use static items or normal widget
end

SFR -> User : Show token-ref candidates in dropdown
@enduml
