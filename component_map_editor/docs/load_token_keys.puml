@startuml
title PropertyPanel Runtime - Token Ref Options Loading (Activity Diagram)

start

:User selects a component in GraphCanvas;
:PropertyPanel.item updated;
:PropertyPanel resolves selected object as component;
:Set componentTarget = "component/<type>";

:Request typed schema model from PropertySchemaRegistry\ntypedSectionModelForTarget(componentTarget);
:PropertyPanel receives activeSchemaSectionModel;

:Set DynamicOptionsRegistry.graph = graph;
:Set DynamicOptionsRegistry.targetComponentId = selected component.id;
:DynamicOptionsRegistry.refresh();

:Read graph.connectionList();

while (More connections?) is (yes)
  :Take next connection;
  if (connection.targetId == targetComponentId?) then (yes)
    :Look up source component and its declared output keys;
    :Add tokenRef candidate per output key;
  else (no)
    :Skip connection;
  endif
endwhile (no)

:Deduplicate + sort options by text;
:Register options under source key "tokenRef";
:Emit targetSourceOptionsChanged;

:PropertyPanel passes dynamicOptions\n= registry.targetSourceOptions to SchemaFormRenderer;

while (More schema fields?) is (yes)
  :Read field.dropdownOptions.sourceKey;
  if (sourceKey == "tokenRef"?) then (yes)
    if (dynamic token list not empty?) then (yes)
      :Render dropdown with tokenRef options;
    else (no)
      :Fallback to textfield;
    endif
  else (no)
    :Use normal widget resolution;
  endif
endwhile (no)

:Dropdown values visible in PropertyPanel;

fork
  :Connection added/removed in graph;
fork again
  :Existing connection tokenKey changed;
fork again
  :User selects another component;
end fork

:DynamicOptionsRegistry refresh triggered again;
:PropertyPanel/Renderer bindings auto-update options;

stop
@enduml
