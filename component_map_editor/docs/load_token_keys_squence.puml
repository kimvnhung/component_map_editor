@startuml
title PropertyPanel Runtime Flow - Token Ref Options Loading

actor User
participant "GraphCanvas\n(selection source)" as Canvas
participant "PropertyPanel\n(QML)" as Panel
participant "PropertySchemaRegistry\n(C++)" as SchemaRegistry
participant "DynamicOptionsRegistry\n(C++)" as Catalog
participant "GraphModel\n(C++)" as Graph
participant "ConnectionModel[*]\n(C++)" as Conn
participant "SchemaFormRenderer\n(QML)" as Renderer

== Selection ==
User -> Canvas : Click component (e.g. Add)
Canvas -> Panel : set item = selected component
Panel -> Panel : resolve item -> component\nset componentTarget = "component/<type>"

== Schema load ==
Panel -> SchemaRegistry : typedSectionModelForTarget(componentTarget)
SchemaRegistry --> Panel : activeSchemaSectionModel (fields include dropdownOptions.sourceKey=tokenRef)

== Registry inputs ==
Panel -> Catalog : set graph
Panel -> Catalog : set targetComponentId = component.id

== Token ref refresh ==
Catalog -> Graph : connectionList()
loop for each connection
  Catalog -> Conn : read targetId, sourceId
  alt targetId == current component.id
    Catalog -> Catalog : keep source output keys
  else
    Catalog -> Catalog : ignore
  end
end
Catalog -> Catalog : dedupe + sort options by text
Catalog --> Panel : targetSourceOptionsChanged()

== Dynamic options into renderer ==
Panel -> Panel : dynamicOptions = catalog.targetSourceOptions
Panel -> Renderer : schemaSectionModel + dynamicOptions + modelObject

== Field editor resolution ==
loop for each visible field
  Renderer -> Renderer : sourceKey = field.dropdownOptions.sourceKey
  alt sourceKey == "tokenRef" and list not empty
    Renderer -> Renderer : render dropdown with tokenRef options
  else sourceKey present but list empty
    Renderer -> Renderer : fallback to textfield
  else no sourceKey
    Renderer -> Renderer : normal widget behavior
  end
end

== Runtime updates ==
Graph -> Catalog : connectionAdded/Removed or connectionsChanged
Conn -> Catalog : tokenKeyChanged
Catalog -> Catalog : refresh()
Catalog --> Panel : targetSourceOptionsChanged()
Panel -> Renderer : dynamic options auto-updated (binding)

@enduml
